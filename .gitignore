nda/

# ── Temporary files ─────────────────────────────────────────────────────────
test_lgx_simple
test_lgx_simple.c
*.out

# ── Documentation build artifacts ───────────────────────────────────────────
docs/_build/
docs/.doctrees/

# ── Editor and IDE ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
# Kiro IDE configuration (user-specific)
/.kiro/

# ── Agent and tooling scratch ───────────────────────────────────────────────
# .worktrees/ holds the git worktrees agents work in; .superpowers/ holds the
# transient per-plan state they produce (ledgers, briefs, review packages).
# Neither belongs in the product repository.
#
# docs/superpowers/plans/ is deliberately NOT ignored: those are the written
# remediation plans for this project and are meant to be read and reviewed by
# humans. The transient review output that lands beside them is ignored below.
#
# include/lgx_runtime.h.syms is a GENERATED build artifact (emitted next to the
# header it describes), not a source file.
.opencode/
.superpowers/
.worktrees/
docs/superpowers/**/review-*.diff
docs/superpowers/**/final-review.diff
docs/superpowers/**/final-fix-review.diff
docs/superpowers/**/task-*.md
docs/superpowers/**/task-*-report.md
include/lgx_runtime.h.syms

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
ENV/

# ── macOS ───────────────────────────────────────────────────────────────────
.AppleDouble
.LSOverride

# ── Windows ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Development scripts (user-specific), except the ones CI gates depend on ──
# scripts/verify_benchmark_methodology.sh fails the build if the frame-arena
# benchmark stops exercising lgx_frame_reset(), so it must be tracked.
# scripts/verify_test_integrity.sh fails the build if a test cannot report
# failure; scripts/count_tests.sh produces the census it is measured against;
# scripts/check_gate_scripts_tracked.sh is what keeps all three tracked.
/scripts/*
!/scripts/verify_benchmark_methodology.sh
!/scripts/verify_test_integrity.sh
!/scripts/count_tests.sh
!/scripts/check_gate_scripts_tracked.sh
!/scripts/run_chaos_tests.sh

